<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TokiAiAssistant</AssemblyName>
    <RootNamespace>TokiAi</RootNamespace>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HaRepacker\Harepacker-resurrected.csproj"><Private>false</Private></ProjectReference>
    <ProjectReference Include="..\MapleLib\MapleLib\MapleLib.csproj"><Private>false</Private></ProjectReference>
    <ProjectReference Include="..\HaSharedLibrary\HaSharedLibrary.csproj"><Private>false</Private></ProjectReference>
    <!-- Newtonsoft.Json and MonoGame.Framework arrive transitively through MapleLib. -->
  </ItemGroup>
</Project>
